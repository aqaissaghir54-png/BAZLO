rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /products/{id} { allow read: if true; allow create,update,delete: if isAdmin(); }
  match /orders/{id} { allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid; allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isAdmin()); allow update,delete: if isAdmin(); }
  match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
 }
}
